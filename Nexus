            local Name    = cfg.Name    or "Toggle"
            local Desc    = cfg.Desc    or ""
            local Default = cfg.Default or false
            local Icon    = cfg.Icon    or "⚡"
            local Callback = cfg.Callback or function() end

            local state = Default

            local Card = Create("Frame", {
                Size = UDim2.new(1, 0, 0, Desc ~= "" and 60 or 46),
                BackgroundColor3 = Theme.BG_Card,
                BorderSizePixel = 0,
                ZIndex = 4,
                Parent = TabPanel,
            })
            MakeCorner(Card, 9)
            MakeStroke(Card, Theme.Border, 1)
            MakePadding(Card, 0, 0, 14, 14)

            -- Icon
            Create("TextLabel", {
                Size = UDim2.new(0, 28, 0, 28),
                Position = UDim2.new(0, 0, 0.5, -14),
                BackgroundColor3 = Theme.Accent,
                BackgroundTransparency = 0.75,
                Text = Icon,
                TextSize = 15,
                Font = Enum.Font.GothamBold,
                TextColor3 = Theme.Accent,
                ZIndex = 5,
                Parent = Card,
            })
            MakeCorner(Card:FindFirstChildOfClass("TextLabel"), 7)

            -- Name
            Create("TextLabel", {
                Size = UDim2.new(1, -90, 0, 18),
                Position = UDim2.new(0, 38, 0, Desc ~= "" and 12 or 14),
                BackgroundTransparency = 1,
                Text = Name,
                TextColor3 = Theme.TextPrimary,
                TextSize = 13,
                Font = Enum.Font.GothamSemibold,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 5,
                Parent = Card,
            })

            if Desc ~= "" then
                Create("TextLabel", {
                    Size = UDim2.new(1, -90, 0, 14),
                    Position = UDim2.new(0, 38, 0, 32),
                    BackgroundTransparency = 1,
                    Text = Desc,
                    TextColor3 = Theme.TextSecond,
                    TextSize = 10,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 5,
                    Parent = Card,
                })
            end

            -- Toggle Track
            local Track = Create("Frame", {
                Size = UDim2.new(0, 44, 0, 24),
                Position = UDim2.new(1, -44, 0.5, -12),
                BackgroundColor3 = state and Theme.ToggleOn or Theme.ToggleOff,
                BorderSizePixel = 0,
                ZIndex = 5,
                Parent = Card,
            })
            MakeCorner(Track, 12)
            MakeStroke(Track, state and Theme.Accent or Theme.Border, 1)

            local Dot = Create("Frame", {
                Size = UDim2.new(0, 18, 0, 18),
                Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
                BackgroundColor3 = Theme.ToggleDot,
                BorderSizePixel = 0,
                ZIndex = 6,
                Parent = Track,
            })
            MakeCorner(Dot, 9)

            local function SetState(val)
                state = val
                Tween(Track, TweenFast, {BackgroundColor3 = state and Theme.ToggleOn or Theme.ToggleOff})
                Tween(Dot, TweenFast, {
                    Position = state
                        and UDim2.new(1, -21, 0.5, -9)
                        or  UDim2.new(0, 3, 0.5, -9)
                })
                pcall(Callback, state)
            end

            Card.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    SetState(not state)
                    Tween(Card, TweenFast, {BackgroundColor3 = Theme.BG_CardHover})
                end
            end)
            Card.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    Tween(Card, TweenFast, {BackgroundColor3 = Theme.BG_Card})
                end
            end)
            Card.MouseEnter:Connect(function()
                Tween(Card, TweenFast, {BackgroundColor3 = Theme.BG_CardHover})
            end)
            Card.MouseLeave:Connect(function()
                Tween(Card, TweenFast, {BackgroundColor3 = Theme.BG_Card})
            end)

            return {
                Set = function(_, v) SetState(v) end,
                Get = function(_) return state end,
            }
        end

        -- ════════════════════════════════════
        --   SLIDER
        -- ════════════════════════════════════
        function SectionObj:AddSlider(cfg)
            cfg = cfg or {}
            local Name     = cfg.Name     or "Slider"
            local Desc     = cfg.Desc     or ""
            local Min      = cfg.Min      or 0
            local Max      = cfg.Max      or 100
            local Default  = cfg.Default  or 50
            local Suffix   = cfg.Suffix   or ""
            local Icon     = cfg.Icon     or "🏃"
            local Callback = cfg.Callback or function() end

            local value = math.clamp(Default, Min, Max)
            local dragging = false

            local Card = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 76),
                BackgroundColor3 = Theme.BG_Card,
                BorderSizePixel = 0,
                ZIndex = 4,
                Parent = TabPanel,
            })
            MakeCorner(Card, 9)
            MakeStroke(Card, Theme.Border, 1)
            MakePadding(Card, 0, 0, 14, 14)

            Create("TextLabel", {
                Size = UDim2.new(0, 28, 0, 28),
                Position = UDim2.new(0, 0, 0, 12),
                BackgroundColor3 = Theme.Accent,
                BackgroundTransparency = 0.75,
                Text = Icon,
                TextSize = 15,
                Font = Enum.Font.GothamBold,
                TextColor3 = Theme.Accent,
                ZIndex = 5,
                Parent = Card,
            })
            MakeCorner(Card:FindFirstChildOfClass("TextLabel"), 7)

            Create("TextLabel", {
                Size = UDim2.new(1, -80, 0, 18),
                Position = UDim2.new(0, 38, 0, 14),
                BackgroundTransparency = 1,
                Text = Name,
                TextColor3 = Theme.TextPrimary,
                TextSize = 13,
                Font = Enum.Font.GothamSemibold,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 5,
                Parent = Card,
            })

            local ValueLabel = Create("TextLabel", {
                Size = UDim2.new(0, 50, 0, 18),
                Position = UDim2.new(1, -50, 0, 14),
                BackgroundTransparency = 1,
                Text = tostring(value) .. Suffix,
                TextColor3 = Theme.TextSecond,
                TextSize = 12,
                Font = Enum.Font.GothamSemibold,
                TextXAlignment = Enum.TextXAlignment.Right,
                ZIndex = 5,
                Parent = Card,
            })

            -- Slider track
            local Track = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 6),
                Position = UDim2.new(0, 0, 0, 48),
                BackgroundColor3 = Theme.SliderBG,
                BorderSizePixel = 0,
                ZIndex = 5,
                Parent = Card,
            })
            MakeCorner(Track, 3)

            local Fill = Create("Frame", {
                Size = UDim2.new((value - Min) / (Max - Min), 0, 1, 0),
                BackgroundColor3 = Theme.SliderFill,
                BorderSizePixel = 0,
                ZIndex = 6,
                Parent = Track,
            })
            MakeCorner(Fill, 3)

            local DotFrame = Create("Frame", {
                Size = UDim2.new(0, 14, 0, 14),
                Position = UDim2.new((value - Min) / (Max - Min), -7, 0.5, -7),
                BackgroundColor3 = Theme.SliderDot,
                BorderSizePixel = 0,
                ZIndex = 7,
                Parent = Track,
            })
            MakeCorner(DotFrame, 7)
            MakeStroke(DotFrame, Theme.Accent, 2)

            local function UpdateSlider(input)
                local trackAbsPos  = Track.AbsolutePosition
                local trackAbsSize = Track.AbsoluteSize
                local relX = math.clamp((input.Position.X - trackAbsPos.X) / trackAbsSize.X, 0, 1)
                value = math.floor(Min + relX * (Max - Min))
                local fillScale = (value - Min) / (Max - Min)
                Fill.Size = UDim2.new(fillScale, 0, 1, 0)
                DotFrame.Position = UDim2.new(fillScale, -7, 0.5, -7)
                ValueLabel.Text = tostring(value) .. Suffix
                pcall(Callback, value)
            end

            Track.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    UpdateSlider(inp)
                end
            end)

            UserInputService.InputChanged:Connect(function(inp)
                if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
                    UpdateSlider(inp)
                end
            end)

            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)

            Card.MouseEnter:Connect(function()
                Tween(Card, TweenFast, {BackgroundColor3 = Theme.BG_CardHover})
            end)
            Card.MouseLeave:Connect(function()
                Tween(Card, TweenFast, {BackgroundColor3 = Theme.BG_Card})
            end)

            return {
                Set = function(_, v)
                    value = math.clamp(v, Min, Max)
                    local fillScale = (value - Min) / (Max - Min)
                    Fill.Size = UDim2.new(fillScale, 0, 1, 0)
                    DotFrame.Position = UDim2.new(fillScale, -7, 0.5, -7)
                    ValueLabel.Text = tostring(value) .. Suffix
                end,
                Get = function(_) return value end,
            }
        end

