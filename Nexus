            Name = "Panel_" .. TabName,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Accent,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
            ZIndex = 3,
            Parent = self._content,
        })
        MakePadding(TabPanel, 14, 14, 14, 14)
        MakeListLayout(TabPanel, 8)

        local function SelectTab()
            for _, t in pairs(self._tabs) do
                Tween(t.btn, TweenFast, {BackgroundTransparency = 1})
                Tween(t.label, TweenFast, {TextColor3 = Theme.TextSecond})
                Tween(t.bar, TweenFast, {BackgroundTransparency = 1})
                t.panel.Visible = false
            end
            Tween(TabBtn, TweenFast, {BackgroundTransparency = 0, BackgroundColor3 = Theme.Accent})
            Tween(TabLabel, TweenFast, {TextColor3 = Theme.TextPrimary})
            Tween(ActiveBar, TweenFast, {BackgroundTransparency = 0})
            TabPanel.Visible = true
            self._activeTab = TabName
        end

        TabBtn.MouseEnter:Connect(function()
            if self._activeTab ~= TabName then
                Tween(TabBtn, TweenFast, {BackgroundTransparency = 0.7, BackgroundColor3 = Theme.BG_CardHover})
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if self._activeTab ~= TabName then
                Tween(TabBtn, TweenFast, {BackgroundTransparency = 1})
            end
        end)
        TabBtn.MouseButton1Click:Connect(SelectTab)

        local tabData = {
            btn   = TabBtn,
            label = TabLabel,
            bar   = ActiveBar,
            panel = TabPanel,
        }
        table.insert(self._tabs, tabData)

        -- Auto-select first tab
        if #self._tabs == 1 then SelectTab() end

