                Position = UDim2.new(1, -24, 0, 0),
                BackgroundTransparency = 1,
                Text = "▾",
                TextColor3 = Theme.TextSecond,
                TextSize = 12,
                Font = Enum.Font.GothamBold,
                ZIndex = 12,
                Parent = DropBox,
            })

            -- Dropdown list
            local DropList = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                Position = UDim2.new(0, 0, 1, 4),
                BackgroundColor3 = Theme.DropBG,
                BorderSizePixel = 0,
                ClipsDescendants = true,
                ZIndex = 20,
                Visible = false,
                Parent = DropBox,
            })
            MakeCorner(DropList, 7)
            MakeStroke(DropList, Theme.Border, 1)

            local DropListLayout = MakeListLayout(DropList, 2)
            MakePadding(DropList, 4, 4, 4, 4)

            local function CloseDropdown()
                open = false
                Tween(DropList, TweenFast, {Size = UDim2.new(1, 0, 0, 0)})
                task.delay(0.15, function() DropList.Visible = false end)
            end

            local function OpenDropdown()
                open = true
                DropList.Visible = true
                local totalH = 4 + 4 + (#Options * 28) + (#Options - 1) * 2
                Tween(DropList, TweenFast, {Size = UDim2.new(1, 0, 0, totalH)})
            end

            for _, opt in ipairs(Options) do
                local Item = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 28),
                    BackgroundColor3 = Theme.DropItem,
                    BackgroundTransparency = 1,
                    Text = opt,
                    TextColor3 = opt == selected and Theme.AccentLight or Theme.TextPrimary,
                    TextSize = 12,
                    Font = Enum.Font.Gotham,
                    AutoButtonColor = false,
                    ZIndex = 21,
                    Parent = DropList,
                })
                MakeCorner(Item, 5)

                Item.MouseEnter:Connect(function()
                    Tween(Item, TweenFast, {BackgroundTransparency = 0, BackgroundColor3 = Theme.DropHover})
                end)
                Item.MouseLeave:Connect(function()
                    Tween(Item, TweenFast, {BackgroundTransparency = 1})
                end)
                Item.MouseButton1Click:Connect(function()
                    selected = opt
                    SelectedLabel.Text = selected
                    CloseDropdown()
                    pcall(Callback, selected)
                    for _, it in pairs(DropList:GetChildren()) do
                        if it:IsA("TextButton") then
                            Tween(it, TweenFast, {TextColor3 = it.Text == selected and Theme.AccentLight or Theme.TextPrimary})
                        end
                    end
                end)
            end

            DropBox.MouseButton1Click:Connect(function()
                if open then CloseDropdown() else OpenDropdown() end
            end)

            Card.MouseEnter:Connect(function()
                Tween(Card, TweenFast, {BackgroundColor3 = Theme.BG_CardHover})
            end)
            Card.MouseLeave:Connect(function()
                Tween(Card, TweenFast, {BackgroundColor3 = Theme.BG_Card})
            end)

            return {
                Set = function(_, v) selected = v; SelectedLabel.Text = v end,
                Get = function(_) return selected end,
            }
        end

