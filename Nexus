-- ═══════════════════════════════════════
--        NOTIFICATION SYSTEM
-- ═══════════════════════════════════════
function NovaUI:Notify(cfg)
    cfg = cfg or {}
    local Title   = cfg.Title   or "Nova UI"
    local Desc    = cfg.Desc    or "Notification"
    local Duration = cfg.Duration or 3
    local Type    = cfg.Type    or "info" -- info, success, warn, error

    local TypeColors = {
        info    = Color3.fromRGB(99, 88, 230),
        success = Color3.fromRGB(60, 200, 100),
        warn    = Color3.fromRGB(240, 170, 50),
        error   = Color3.fromRGB(220, 60, 60),
    }
    local TypeIcons = {
        info    = "ℹ",
        success = "✔",
        warn    = "⚠",
        error   = "✖",
    }

    local accentColor = TypeColors[Type] or TypeColors.info
    local icon = TypeIcons[Type] or "ℹ"

    -- find or create notification container
    local gui = game:GetService("CoreGui"):FindFirstChild("NovaUI_GUI")
    if not gui then return end

    local notifHolder = gui:FindFirstChild("NotifHolder")
    if not notifHolder then
        notifHolder = Create("Frame", {
            Name = "NotifHolder",
            Size = UDim2.new(0, 280, 1, 0),
            Position = UDim2.new(1, -290, 0, 0),
            BackgroundTransparency = 1,
            ZIndex = 100,
            Parent = gui,
        })
        MakeListLayout(notifHolder, 8, Enum.FillDirection.Vertical,
            Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)
        MakePadding(notifHolder, 0, 16, 0, 0)
    end

    local Notif = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 70),
        BackgroundColor3 = Theme.BG_Card,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 101,
        Parent = notifHolder,
    })
    MakeCorner(Notif, 10)
    MakeStroke(Notif, accentColor, 1.5)

    -- Colored side bar
    Create("Frame", {
        Size = UDim2.new(0, 4, 1, -16),
        Position = UDim2.new(0, 0, 0, 8),
        BackgroundColor3 = accentColor,
        BorderSizePixel = 0,
        ZIndex = 102,
        Parent = Notif,
    })
    MakeCorner(Notif:FindFirstChildOfClass("Frame"), 2)

    Create("TextLabel", {
        Size = UDim2.new(0, 28, 0, 28),
        Position = UDim2.new(0, 14, 0.5, -14),
        BackgroundColor3 = accentColor,
        BackgroundTransparency = 0.75,
        Text = icon,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        TextColor3 = accentColor,
        ZIndex = 102,
        Parent = Notif,
    })
    MakeCorner(Notif:FindFirstChildOfClass("TextLabel"), 7)

    Create("TextLabel", {
        Size = UDim2.new(1, -58, 0, 18),
        Position = UDim2.new(0, 50, 0, 14),
        BackgroundTransparency = 1,
        Text = Title,
        TextColor3 = Theme.TextPrimary,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 102,
        Parent = Notif,
    })

    Create("TextLabel", {
        Size = UDim2.new(1, -58, 0, 14),
        Position = UDim2.new(0, 50, 0, 34),
        BackgroundTransparency = 1,
        Text = Desc,
        TextColor3 = Theme.TextSecond,
        TextSize = 10,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        ZIndex = 102,
        Parent = Notif,
    })

    -- Progress bar
    local Progress = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 3),
        Position = UDim2.new(0, 0, 1, -3),
        BackgroundColor3 = accentColor,
        BorderSizePixel = 0,
        ZIndex = 103,
        Parent = Notif,
    })

    -- Animate in
    Tween(Notif, TweenMedium, {BackgroundTransparency = 0})

    -- Progress shrink
    Tween(Progress, TweenInfo.new(Duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 3)})

    task.delay(Duration, function()
        Tween(Notif, TweenMedium, {BackgroundTransparency = 1})
        task.delay(0.3, function()
            Notif:Destroy()
        end)
    end)
end

